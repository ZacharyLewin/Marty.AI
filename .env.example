# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — required when EMBED_BACKEND=openai (the default)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────────────────────

# URL of your deployed frontend (used by backend CORS policy)
# Default: http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Embedding backend:
#   openai  — uses text-embedding-3-small via the OpenAI API (default, best quality)
#   local   — uses SentenceTransformers all-MiniLM-L6-v2 (free, runs on CPU)
EMBED_BACKEND=openai
